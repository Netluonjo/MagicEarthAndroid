<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/me_bg_card"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/truck_profile_title"
        android:textColor="@color/me_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tránh cầu vượt hạn chế chiều cao, đường hẹp cấm tải và cầu yếu"
        android:textColor="@color/me_text_secondary"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxStrokeColor="@color/me_primary"
        app:hintTextColor="@color/me_primary_light"
        android:hint="@string/truck_weight_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTruckWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:text="18.0"
            android:textColor="@color/me_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:boxStrokeColor="@color/me_primary"
        app:hintTextColor="@color/me_primary_light"
        android:hint="@string/truck_height_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTruckHeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:text="3.9"
            android:textColor="@color/me_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:boxStrokeColor="@color/me_primary"
        app:hintTextColor="@color/me_primary_light"
        android:hint="@string/truck_axle_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTruckAxles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="3"
            android:textColor="@color/me_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveTruckConfig"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:text="@string/apply_truck_profile"
        android:textColor="@color/me_text_primary"
        android:textStyle="bold"
        app:backgroundTint="@color/me_primary"
        app:cornerRadius="16dp" />

</LinearLayout>
